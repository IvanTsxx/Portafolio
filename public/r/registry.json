{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ivan",
  "homepage": "https://bongi.dev",
  "items": [
    {
      "name": "technical-grid",
      "type": "registry:ui",
      "title": "Animated Technical Grid",
      "description": "Hairline blueprint grid with a scan line, pulsing nodes and corner marks.",
      "categories": ["backgrounds", "motion"],
      "dependencies": ["class-variance-authority"],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/ivan/ui/technical-grid.tsx",
          "type": "registry:ui",
          "target": "@ui/technical-grid.tsx"
        }
      ],
      "cssVars": {
        "theme": {
          "color-clay": "var(--clay)"
        },
        "light": {
          "clay": "oklch(0.52 0.13 42)"
        },
        "dark": {
          "clay": "oklch(0.7 0.14 45)"
        }
      },
      "css": {
        "@keyframes technical-grid-scan-y": {
          "0%": {
            "transform": "translateY(-100%)",
            "opacity": "0"
          },
          "8%": {
            "opacity": "1"
          },
          "92%": {
            "opacity": "1"
          },
          "100%": {
            "transform": "translateY(0)",
            "opacity": "0"
          }
        },
        "@keyframes technical-grid-scan-x": {
          "0%": {
            "transform": "translateX(-100%)",
            "opacity": "0"
          },
          "8%": {
            "opacity": "1"
          },
          "92%": {
            "opacity": "1"
          },
          "100%": {
            "transform": "translateX(0)",
            "opacity": "0"
          }
        },
        "@keyframes technical-grid-ping": {
          "0%": {
            "transform": "scale(1)",
            "opacity": "0.7"
          },
          "70%": {
            "transform": "scale(4)",
            "opacity": "0"
          },
          "100%": {
            "transform": "scale(4)",
            "opacity": "0"
          }
        }
      },
      "meta": {
        "docs": {
          "props": [
            {
              "component": "TechnicalGrid",
              "description": "A div that paints the grid behind its children.",
              "props": [
                {
                  "name": "tone",
                  "type": "\"muted\" | \"strong\" | \"clay\"",
                  "default": "\"muted\"",
                  "description": "Line intensity and ink. clay tints the lines, scan and nodes."
                },
                {
                  "name": "fade",
                  "type": "\"none\" | \"edges\" | \"top\" | \"bottom\"",
                  "default": "\"none\"",
                  "description": "Fades the grid toward the edges or one side."
                },
                {
                  "name": "cellSize",
                  "type": "number",
                  "default": "32",
                  "description": "Minor cell size in px. Clamped between 8 and 160."
                },
                {
                  "name": "majorEvery",
                  "type": "number",
                  "default": "4",
                  "description": "Every Nth line is drawn stronger. 0 or 1 disables major lines."
                },
                {
                  "name": "scan",
                  "type": "\"none\" | \"horizontal\" | \"vertical\" | \"both\"",
                  "default": "\"horizontal\"",
                  "description": "Direction of the sweeping scan line."
                },
                {
                  "name": "scanDuration",
                  "type": "number",
                  "default": "8",
                  "description": "Seconds per sweep. Clamped between 1 and 60."
                },
                {
                  "name": "nodes",
                  "type": "number",
                  "default": "5",
                  "description": "Pulsing nodes snapped to grid lines. Maximum 24."
                },
                {
                  "name": "markers",
                  "type": "boolean",
                  "default": "true",
                  "description": "Registration marks in the four corners."
                },
                {
                  "name": "label",
                  "type": "string",
                  "description": "Mono caption pinned to the top left."
                },
                {
                  "name": "caption",
                  "type": "string",
                  "description": "Mono caption pinned to the bottom right."
                },
                {
                  "name": "animated",
                  "type": "boolean",
                  "default": "true",
                  "description": "Turns the scan and pulses off. The static grid stays."
                }
              ]
            }
          ],
          "variants": [
            {
              "name": "tone",
              "default": "muted",
              "options": ["muted", "strong", "clay"],
              "description": "Ink at 6 and 12 percent, 10 and 22 percent, or clay."
            },
            {
              "name": "fade",
              "default": "none",
              "options": ["none", "edges", "top", "bottom"],
              "description": "Mask on the grid field only, never on children."
            }
          ],
          "examples": [
            {
              "title": "Grid as a framed field",
              "file": "registry/ivan/examples/technical-grid/basic.tsx"
            },
            {
              "title": "Grid as a section background",
              "file": "registry/ivan/examples/technical-grid/background.tsx"
            }
          ],
          "accessibility": [
            "Grid, scan line, nodes and marks are aria-hidden and ignore pointer events.",
            "label and caption are real text at 4.5:1 or more.",
            "Reduced motion hides the scan and pulses. The static grid stays."
          ],
          "animation": [
            {
              "target": "Scan line",
              "properties": "transform, opacity",
              "timing": "scanDuration seconds, linear, infinite",
              "trigger": "On mount",
              "reducedMotion": "Hidden."
            },
            {
              "target": "Node pulse ring",
              "properties": "transform, opacity",
              "timing": "3 to 5 seconds, ease-out, infinite",
              "trigger": "On mount",
              "reducedMotion": "Ring hidden. Dot stays."
            }
          ]
        }
      }
    },
    {
      "name": "agent-status-card",
      "type": "registry:ui",
      "title": "Agent Status Card",
      "description": "Status card for an agent run with a task line, segmented progress and mono metadata.",
      "categories": ["cards", "data"],
      "dependencies": ["class-variance-authority"],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/ivan/ui/agent-status-card.tsx",
          "type": "registry:ui",
          "target": "@ui/agent-status-card.tsx"
        }
      ],
      "cssVars": {
        "theme": {
          "color-clay": "var(--clay)",
          "color-signal-moss": "var(--signal-moss)",
          "color-signal-steel": "var(--signal-steel)"
        },
        "light": {
          "clay": "oklch(0.52 0.13 42)",
          "signal-moss": "oklch(0.5 0.09 150)",
          "signal-steel": "oklch(0.5 0.07 240)"
        },
        "dark": {
          "clay": "oklch(0.7 0.14 45)",
          "signal-moss": "oklch(0.72 0.09 150)",
          "signal-steel": "oklch(0.7 0.05 240)"
        }
      },
      "meta": {
        "docs": {
          "props": [
            {
              "component": "AgentStatusCard",
              "description": "Header, body, optional metadata and footer.",
              "props": [
                {
                  "name": "agentId",
                  "type": "string",
                  "required": true,
                  "description": "Designation shown above the name, for example AG-03."
                },
                {
                  "name": "name",
                  "type": "string",
                  "required": true,
                  "description": "Role or agent name. Labels the article and truncates when long."
                },
                {
                  "name": "task",
                  "type": "string",
                  "required": true,
                  "description": "One line describing what the agent is doing."
                },
                {
                  "name": "status",
                  "type": "\"idle\" | \"running\" | \"review\" | \"blocked\" | \"done\"",
                  "default": "\"idle\"",
                  "description": "Drives the tone color, the status dot and the default status label."
                },
                {
                  "name": "statusLabel",
                  "type": "string",
                  "description": "Overrides the default status text."
                },
                {
                  "name": "progress",
                  "type": "number",
                  "description": "0 to 100. Omit to hide the bar."
                },
                {
                  "name": "meta",
                  "type": "{ label: string; value: string }[]",
                  "description": "Mono key and value pairs in equal columns."
                },
                {
                  "name": "footer",
                  "type": "ReactNode",
                  "description": "Slot under a hairline for actions."
                },
                {
                  "name": "announce",
                  "type": "boolean",
                  "default": "false",
                  "description": "Makes the status a polite live region."
                },
                {
                  "name": "children",
                  "type": "ReactNode",
                  "description": "Extra content rendered in the body under the progress bar."
                }
              ]
            }
          ],
          "variants": [
            {
              "name": "status",
              "default": "idle",
              "options": ["idle", "running", "review", "blocked", "done"],
              "description": "Tone paints the hairline, cube, dot and progress. idle muted, running clay, review steel, blocked destructive, done moss."
            }
          ],
          "examples": [
            {
              "title": "Running agent",
              "file": "registry/ivan/examples/agent-status-card/basic.tsx"
            },
            {
              "title": "Awaiting a human decision",
              "file": "registry/ivan/examples/agent-status-card/review.tsx"
            }
          ],
          "accessibility": [
            "An article labelled by the name heading.",
            "Status is always text. Dot and tone are redundant cues.",
            "announce makes the status a polite live region. Off by default.",
            "Tone colors keep 4.5:1 against the card in both themes."
          ],
          "animation": [
            {
              "target": "Running status dot",
              "properties": "transform, opacity",
              "timing": "animate-ping, 1 second, infinite",
              "trigger": "While status is running",
              "reducedMotion": "Ring removed. Dot stays."
            },
            {
              "target": "Active progress segment",
              "properties": "opacity",
              "timing": "animate-pulse, 2 seconds, infinite",
              "trigger": "First unfilled segment while running",
              "reducedMotion": "Steady at 60 percent."
            }
          ]
        }
      }
    },
    {
