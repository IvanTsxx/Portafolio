    {
      "name": "text-scramble",
      "type": "registry:ui",
      "title": "Text Scramble Reveal",
      "description": "Monospace text that resolves out of noise glyphs. The real text is always in the DOM.",
      "categories": ["text", "motion"],
      "dependencies": ["class-variance-authority"],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/ivan/ui/text-scramble.tsx",
          "type": "registry:ui",
          "target": "@ui/text-scramble.tsx"
        },
        {
          "path": "registry/ivan/hooks/use-prefers-reduced-motion.ts",
          "type": "registry:hook",
          "target": "@hooks/use-prefers-reduced-motion.ts"
        }
      ],
      "cssVars": {
        "theme": {
          "color-clay": "var(--clay)"
        },
        "light": {
          "clay": "oklch(0.52 0.13 42)"
        },
        "dark": {
          "clay": "oklch(0.7 0.14 45)"
        }
      },
      "meta": {
        "docs": {
          "props": [
            {
              "component": "TextScramble",
              "description": "Animates its text. Extends every span prop except children.",
              "props": [
                {
                  "name": "text",
                  "type": "string",
                  "required": true,
                  "description": "The final text. Always in the DOM."
                },
                {
                  "name": "trigger",
                  "type": "\"mount\" | \"visible\" | \"hover\" | \"manual\"",
                  "default": "\"visible\"",
                  "description": "When it runs. visible waits for half the text on screen. manual runs when replayKey changes."
                },
                {
                  "name": "duration",
                  "type": "number",
                  "default": "900",
                  "description": "Milliseconds until the last glyph resolves."
                },
                {
                  "name": "charset",
                  "type": "\"technical\" | \"alpha\" | \"binary\" | \"hex\" | \"blocks\"",
                  "default": "\"technical\"",
                  "description": "Preset noise alphabet."
                },
                {
                  "name": "characters",
                  "type": "string",
                  "description": "Custom noise alphabet. Overrides charset."
                },
                {
                  "name": "once",
                  "type": "boolean",
                  "default": "true",
                  "description": "With visible, stop observing after the first reveal."
                },
                {
                  "name": "replayKey",
                  "type": "number | string",
                  "description": "Change it to replay."
                },
                {
                  "name": "as",
                  "type": "\"span\" | \"p\" | \"div\" | \"h1\" | \"h2\" | \"h3\" | \"h4\"",
                  "default": "\"span\"",
                  "description": "Element to render, so headings keep their semantics."
                },
                {
                  "name": "variant",
                  "type": "\"label\" | \"heading\" | \"body\"",
                  "default": "\"label\"",
                  "description": "Type treatment. All three are monospace."
                },
                {
                  "name": "tone",
                  "type": "\"default\" | \"muted\" | \"accent\"",
                  "default": "\"default\"",
                  "description": "Resolved text color. Noise glyphs use clay, or foreground for accent."
                }
              ]
            }
          ],
          "variants": [
            {
              "name": "variant",
              "default": "label",
              "options": ["label", "heading", "body"],
              "description": "label 12 px uppercase, heading 24 px medium, body 14 px."
            },
            {
              "name": "tone",
              "default": "default",
              "options": ["default", "muted", "accent"],
              "description": "Foreground, muted foreground or clay."
            }
          ],
          "examples": [
            {
              "title": "Heading revealed on scroll",
              "file": "registry/ivan/examples/text-scramble/basic.tsx"
            },
            {
              "title": "Hover and manual replay",
              "file": "registry/ivan/examples/text-scramble/interactive.tsx"
            }
          ],
          "accessibility": [
            "The final text is the element's real content. The animated copy is aria-hidden.",
            "Both copies share one grid cell, so nothing shifts.",
            "Reduced motion shows the final text immediately.",
            "Use as to keep real heading levels."
          ],
          "animation": [
            {
              "target": "Glyph resolve",
              "properties": "Text of one span per glyph",
              "timing": "One rAF loop. Noise reshuffles every 45 ms. 70 percent stagger, 30 percent jitter.",
              "trigger": "Mount, half visible, pointer enter, focus or replayKey",
              "reducedMotion": "Skipped."
            },
            {
              "target": "Unresolved glyph color",
              "properties": "color",
              "timing": "Switches when a glyph resolves",
              "trigger": "Per glyph",
              "reducedMotion": "Not applicable."
            }
          ]
        }
      }
    },
