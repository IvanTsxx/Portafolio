  "items": [
    {
      "name": "technical-grid",
      "type": "registry:ui",
      "title": "Animated Technical Grid",
      "description": "Hairline blueprint grid with a scan line and pulsing nodes.",
      "categories": ["backgrounds", "motion"],
      "dependencies": ["class-variance-authority"],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/ivan/ui/technical-grid.tsx",
          "type": "registry:ui",
          "target": "@ui/technical-grid.tsx"
        }
      ],
      "cssVars": {
        "theme": {
          "color-clay": "var(--clay)"
        },
        "light": {
          "clay": "oklch(0.52 0.13 42)"
        },
        "dark": {
          "clay": "oklch(0.7 0.14 45)"
        }
      },
      "css": {
        "@keyframes technical-grid-scan-y": {
          "0%": {
            "transform": "translateY(-100%)",
            "opacity": "0"
          },
          "8%": {
            "opacity": "1"
          },
          "92%": {
            "opacity": "1"
          },
          "100%": {
            "transform": "translateY(0)",
            "opacity": "0"
          }
        },
        "@keyframes technical-grid-scan-x": {
          "0%": {
            "transform": "translateX(-100%)",
            "opacity": "0"
          },
          "8%": {
            "opacity": "1"
          },
          "92%": {
            "opacity": "1"
          },
          "100%": {
            "transform": "translateX(0)",
            "opacity": "0"
          }
        },
        "@keyframes technical-grid-ping": {
          "0%": {
            "transform": "scale(1)",
            "opacity": "0.7"
          },
          "70%": {
            "transform": "scale(4)",
            "opacity": "0"
          },
          "100%": {
            "transform": "scale(4)",
            "opacity": "0"
          }
        }
      },
      "meta": {
        "docs": {
          "props": [
            {
              "component": "TechnicalGrid",
              "description": "Paints the grid behind its children.",
              "props": [
                {
                  "name": "tone",
                  "type": "\"muted\" | \"strong\" | \"clay\"",
                  "default": "\"muted\"",
                  "description": "Line intensity and ink."
                },
                {
                  "name": "fade",
                  "type": "\"none\" | \"edges\" | \"top\" | \"bottom\"",
                  "default": "\"none\"",
                  "description": "Fades the grid toward an edge."
                },
                {
                  "name": "cellSize",
                  "type": "number",
                  "default": "32",
                  "description": "Minor cell size in px, 8 to 160."
                },
                {
                  "name": "majorEvery",
                  "type": "number",
                  "default": "4",
                  "description": "Every Nth line is stronger."
                },
                {
                  "name": "scan",
                  "type": "\"none\" | \"horizontal\" | \"vertical\" | \"both\"",
                  "default": "\"horizontal\"",
                  "description": "Scan line direction."
                },
                {
                  "name": "scanDuration",
                  "type": "number",
                  "default": "8",
                  "description": "Seconds per sweep, 1 to 60."
                },
                {
                  "name": "nodes",
                  "type": "number",
                  "default": "5",
                  "description": "Pulsing nodes, up to 24."
                },
                {
                  "name": "markers",
                  "type": "boolean",
                  "default": "true",
                  "description": "Corner registration marks."
                },
                {
                  "name": "label",
                  "type": "string",
                  "description": "Caption, top left."
                },
                {
                  "name": "caption",
                  "type": "string",
                  "description": "Caption, bottom right."
                },
                {
                  "name": "animated",
                  "type": "boolean",
                  "default": "true",
                  "description": "Turns the scan and pulses off."
                }
              ]
            }
          ],
          "variants": [
            {
              "name": "tone",
              "default": "muted",
              "options": ["muted", "strong", "clay"],
              "description": "Line ink: muted, strong or clay."
            },
            {
              "name": "fade",
              "default": "none",
              "options": ["none", "edges", "top", "bottom"],
              "description": "Mask on the grid only."
            }
          ],
          "examples": [
            {
              "title": "Grid as a framed field",
              "file": "registry/ivan/examples/technical-grid/basic.tsx"
            },
            {
              "title": "Grid as a section background",
              "file": "registry/ivan/examples/technical-grid/background.tsx"
            }
          ],
          "accessibility": [
            "Decorative layers are aria-hidden and ignore pointer events.",
            "Reduced motion hides the scan and pulses."
          ],
          "animation": [
            {
              "target": "Scan line",
              "properties": "transform, opacity",
              "timing": "scanDuration seconds, linear",
              "trigger": "On mount",
              "reducedMotion": "Hidden."
            },
            {
              "target": "Node pulse ring",
              "properties": "transform, opacity",
              "timing": "3 to 5 seconds, ease-out",
              "trigger": "On mount",
              "reducedMotion": "Ring hidden."
            }
          ]
        }
      }
    },
