            {
              "target": "Corner marks and press",
              "properties": "opacity, translate, scale 0.97",
              "timing": "300 ms, ease-out-expo",
              "trigger": "Hover, focus-visible, pointer down",
              "reducedMotion": "Transitions removed."
            }
          ]
        }
      }
