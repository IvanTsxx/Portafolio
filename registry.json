              "props": [
                {
                  "name": "head",
                  "type": "\"none\" | \"yellow-hard-hat\" | \"white-hard-hat\" | \"safety-helmet\" | \"deerstalker\" | \"mortarboard\" | \"headset\" | \"goggles\"",
                  "required": true,
                  "description": "Hats and helmets."
                },
                {
                  "name": "face",
                  "type": "\"none\" | \"round-glasses\" | \"pixel-shades\" | \"teal-visor\"",
                  "required": true,
                  "description": "Glasses and shades."
                },
                {
                  "name": "torso",
                  "type": "\"none\" | \"safety-vest\" | \"tweed-vest\" | \"lab-coat\" | \"plaid-coat\" | \"knit-sweater\"",
                  "required": true,
                  "description": "Coats and vests."
                },
                {
                  "name": "held",
                  "type": "\"none\" | \"laptop\" | \"book\" | \"magnifier\" | \"tape-measure\" | \"pointer\" | \"pencil\"",
                  "required": true,
                  "description": "Main prop."
                },
                {
                  "name": "offhand",
                  "type": "\"none\" | \"clipboard\" | \"blueprint-roll\" | \"tablet\"",
                  "required": true,
                  "description": "Left-hand prop."
