      "meta": {
        "docs": {
          "props": [
            {
              "component": "Agent",
              "description": "A group of meshes. Render it inside a Canvas with lights.",
              "props": [
                {
                  "name": "role",
                  "type": "\"orchestrator\" | \"architect\" | \"researcher\" | \"builder\" | \"debugger\" | \"inspector\" | \"analyst\"",
                  "required": true,
                  "description": "Preset outfit from rolePresets."
                },
                {
                  "name": "outfit",
                  "type": "Outfit",
                  "default": "rolePresets[role]",
                  "description": "Mix pieces across roles. Overrides the preset."
                },
                {
                  "name": "animateOutfit",
                  "type": "boolean",
                  "default": "false",
                  "description": "Hops and drops pieces when the outfit changes."
                },
                {
                  "name": "action",
                  "type": "AgentAction",
                  "default": "\"idle\"",
                  "description": "Clip to play. Crossfades over 0.38 seconds."
                },
                {
                  "name": "actionRef",
                  "type": "RefObject<AgentAction>",
                  "description": "Drives the action from a ref without re-rendering."
                },
                {
                  "name": "motion",
                  "type": "\"full\" | \"reduced\"",
                  "default": "prefers-reduced-motion",
                  "description": "reduced holds each key pose."
                },
                {
                  "name": "shadow",
                  "type": "boolean",
                  "default": "true",
                  "description": "Blob contact shadow."
                },
                {
                  "name": "position",
                  "type": "[number, number, number]",
                  "default": "[0, 0, 0]",
                  "description": "Placement. Accepts group props."
                }
              ]
            },
            {
              "component": "Outfit",
              "description": "One piece id per slot.",
              "props": [
                {
                  "name": "head",
                  "type": "\"none\" | \"yellow-hard-hat\" | \"white-hard-hat\" | \"safety-helmet\" | \"deerstalker\" | \"mortarboard\" | \"headset\" | \"goggles\"",
                  "required": true,
                  "description": "Hats and helmets."
                },
                {
                  "name": "face",
                  "type": "\"none\" | \"round-glasses\" | \"pixel-shades\" | \"teal-visor\"",
                  "required": true,
                  "description": "Glasses and shades."
                },
                {
                  "name": "torso",
                  "type": "\"none\" | \"safety-vest\" | \"tweed-vest\" | \"lab-coat\" | \"plaid-coat\" | \"knit-sweater\"",
                  "required": true,
                  "description": "Coats and vests."
                },
                {
                  "name": "held",
                  "type": "\"none\" | \"laptop\" | \"book\" | \"magnifier\" | \"tape-measure\" | \"pointer\" | \"pencil\"",
                  "required": true,
                  "description": "Main prop."
                },
                {
                  "name": "offhand",
                  "type": "\"none\" | \"clipboard\" | \"blueprint-roll\" | \"tablet\"",
                  "required": true,
                  "description": "Left-hand prop."
                }
              ]
            }
          ],
          "variants": [
