    {
      "name": "magnetic-button",
      "type": "registry:ui",
      "title": "Industrial Magnetic Button",
      "description": "Hairline button that leans toward the pointer.",
      "categories": ["buttons", "motion"],
      "dependencies": ["class-variance-authority"],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/ivan/ui/magnetic-button.tsx",
          "type": "registry:ui",
          "target": "@ui/magnetic-button.tsx"
        },
        {
          "path": "registry/ivan/hooks/use-prefers-reduced-motion.ts",
          "type": "registry:hook",
          "target": "@hooks/use-prefers-reduced-motion.ts"
        }
      ],
      "cssVars": {
        "theme": {
          "color-clay": "var(--clay)",
          "ease-out-expo": "cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "light": {
          "clay": "oklch(0.52 0.13 42)"
        },
        "dark": {
          "clay": "oklch(0.7 0.14 45)"
        }
      },
      "meta": {
        "docs": {
          "props": [
            {
              "component": "MagneticButton",
              "description": "A native button. Extends every button prop.",
              "props": [
                {
                  "name": "variant",
                  "type": "\"outline\" | \"solid\" | \"accent\" | \"ghost\"",
                  "default": "\"outline\"",
                  "description": "Surface treatment."
                },
                {
                  "name": "size",
                  "type": "\"sm\" | \"md\" | \"lg\"",
                  "default": "\"md\"",
                  "description": "Height: 36, 44 or 56 px."
                },
                {
                  "name": "strength",
                  "type": "number",
                  "default": "8",
                  "description": "Maximum pull in px. 0 turns it off."
                },
                {
                  "name": "index",
                  "type": "string",
                  "description": "Decorative mono index."
                },
                {
                  "name": "type",
                  "type": "\"button\" | \"submit\" | \"reset\"",
                  "default": "\"button\"",
                  "description": "Native button type."
                }
              ]
            },
            {
              "component": "MagneticLink",
              "description": "The same surface as an anchor.",
              "props": [
                {
                  "name": "href",
                  "type": "string",
                  "required": true,
                  "description": "Destination."
                }
              ]
            }
          ],
          "variants": [
            {
              "name": "variant",
              "default": "outline",
              "options": ["outline", "solid", "accent", "ghost"],
              "description": "Surface treatment."
            },
            {
              "name": "size",
              "default": "md",
              "options": ["sm", "md", "lg"],
              "description": "Height and padding."
            }
          ],
          "examples": [
            {
              "title": "Variants and sizes",
              "file": "registry/ivan/examples/magnetic-button/basic.tsx"
            },
            {
              "title": "Link with an index",
              "file": "registry/ivan/examples/magnetic-button/link.tsx"
            }
          ],
          "accessibility": [
            "A native button or anchor. The hit area is at least 44 by 44 px.",
            "Only mouse and pen pull the button."
          ],
          "animation": [
            {
              "target": "Surface magnet",
              "properties": "translate",
              "timing": "100 ms in, 500 ms out",
              "trigger": "Pointer move",
              "reducedMotion": "No magnet."
            },
            {
              "target": "Fill sweep",
              "properties": "transform",
              "timing": "300 ms, ease-out-expo",
              "trigger": "Hover, focus, press",
              "reducedMotion": "Instant."
            }
          ]
        }
      }
    },
