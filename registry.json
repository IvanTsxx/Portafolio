                {
                  "name": "outfit",
                  "type": "Outfit",
                  "default": "rolePresets[role]",
                  "description": "Mix pieces across roles. Overrides the preset."
                },
                {
                  "name": "animateOutfit",
                  "type": "boolean",
                  "default": "false",
                  "description": "Hops and drops pieces when the outfit changes."
                },
                {
                  "name": "action",
                  "type": "AgentAction",
                  "default": "\"idle\"",
                  "description": "Clip to play. Crossfades over 0.38 seconds."
                },
                {
                  "name": "actionRef",
                  "type": "RefObject<AgentAction>",
                  "description": "Drives the action from a ref without re-rendering."
                },
                {
                  "name": "motion",
                  "type": "\"full\" | \"reduced\"",
                  "default": "prefers-reduced-motion",
                  "description": "reduced holds each key pose."
                },
                {
                  "name": "shadow",
                  "type": "boolean",
                  "default": "true",
                  "description": "Blob contact shadow."
                },
                {
                  "name": "position",
                  "type": "[number, number, number]",
                  "default": "[0, 0, 0]",
                  "description": "Placement. Accepts group props."
